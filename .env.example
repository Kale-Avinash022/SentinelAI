# Environment configuration for SentinelAI (Local Development)
# NOTE: Never commit real secrets or production credentials to source control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Gateway Server
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=change-this-insecure-secret-key-for-local-dev-only-32chars-min

# PostgreSQL Database (Local Docker Compose)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_ai
POSTGRES_USER=sentinel_app
POSTGRES_PASSWORD=sentinel_local_password
DATABASE_URL=postgresql+asyncpg://sentinel_app:sentinel_local_password@127.0.0.1:5432/sentinel_ai

# Redis (Broker & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Active Asynchronous Transport ('celery' or 'sqs')
ASYNC_TRANSPORT=celery

# LLM Providers (Mock by default)
DEFAULT_PROVIDER=fake
LITELLM_MOCK=true
OPENAI_API_KEY=mock-key-do-not-use-real
ANTHROPIC_API_KEY=mock-key-do-not-use-real

# Telemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
ENABLE_DIAGNOSTIC_RETENTION=false

