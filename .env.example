# Environment configuration for SentinelAI (Local Development)
# NOTE: Never commit real secrets or production credentials to source control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Gateway Server
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=change-this-insecure-secret-key-for-local-dev-only-32chars-min

# Authentication / JWT Sessions (Day 012)
# All auth values have safe local defaults; override only when needed.
# Signing key is derived from SECRET_KEY; only HS256 is accepted.
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinelai-api
JWT_AUDIENCE=sentinelai-dashboard
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# cookie_secure is tri-state: leave blank to derive from ENVIRONMENT
# (Secure on only in production). Set true/false to force.
REFRESH_COOKIE_NAME=sentinel_refresh
CSRF_COOKIE_NAME=sentinel_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# Comma-separated exact origins allowed to send credentialed refresh requests.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Fixed-window login throttle (per client IP + email).
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# API Keys (Day 013)
# Rotation overlap window: a rotated predecessor stays valid for at most this
# many seconds (never past its own expiry). 0 collapses the overlap.
API_KEY_ROTATION_GRACE_SECONDS=3600

# LLM Gateway (Day 015)
# All chat values have safe deterministic defaults backed by the fake
# providers; no paid call is made and none of these are read in production
# (production fails closed until a real adapter is wired on Day 016).
# The gateway deadline enforced regardless of what an adapter returns.
LLM_DEFAULT_TIMEOUT_MS=15000
# Hard ceiling on a caller-supplied per-request timeout (client cannot exceed).
LLM_MAX_TIMEOUT_MS=30000
# Upper bound on a request's requested output tokens.
LLM_MAX_OUTPUT_TOKENS=4096
# Which fake behaviour 'sentinel-auto' resolves to: one of success, latency,
# http_429, http_500, malformed, empty, reset.
LLM_FAKE_SCENARIO=success

# PostgreSQL Database (Local Docker Compose)
# NOTE: host port 5433 because a native Windows PostgreSQL occupies host 5432; inside Docker the port is 5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=sentinel_ai

# Superuser / Bootstrap (Local Compose only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_password

# Migration Role (Schema Owner / DDL)
POSTGRES_MIGRATOR_USER=sentinel_migrator
POSTGRES_MIGRATOR_PASSWORD=sentinel_migrator_password
MIGRATION_DATABASE_URL=postgresql+asyncpg://sentinel_migrator:sentinel_migrator_password@127.0.0.1:5433/sentinel_ai

# Application Runtime Role (DML only / Non-owner / NOBYPASSRLS)
POSTGRES_USER=sentinel_app
POSTGRES_PASSWORD=sentinel_local_password
DATABASE_URL=postgresql+asyncpg://sentinel_app:sentinel_local_password@127.0.0.1:5433/sentinel_ai

# Redis (Broker & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Active Asynchronous Transport ('celery' or 'sqs')
ASYNC_TRANSPORT=celery

# LLM Providers (Mock by default)
DEFAULT_PROVIDER=fake
LITELLM_MOCK=true
OPENAI_API_KEY=mock-key-do-not-use-real
ANTHROPIC_API_KEY=mock-key-do-not-use-real

# Telemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
ENABLE_DIAGNOSTIC_RETENTION=false
